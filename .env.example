# Porta do servidor
PORT=3000

# Endereço público do site (usado no link do convite)
BASE_URL=https://amigosecreto.suaempresa.com.br

# Senha da página /admin (usuário: admin)
ADMIN_PASSWORD=troque-esta-senha

# Datas (formato AAAA-MM-DD, horário de São Paulo)
# Último dia de inscrição (inclusive). Depois disso o formulário fecha sozinho.
INSCRICAO_ATE=2026-11-30
# Dia do sorteio (o botão e o sorteio automático liberam a partir dela)
DRAW_DATE=2026-12-01
# Dia da entrega dos chinelos (aparece na página e nos e-mails; opcional)
ENTREGA_DATE=2026-12-14

# Sorteio automático no dia (true/false) e horário de envio (São Paulo, HH:MM)
AUTO_SORTEIO=true
AUTO_HORA=09:00

# Texto extra nos e-mails (opcional)
OBS=Troca dos presentes na confraternização.

# SMTP (sem SMTP_HOST = modo teste: e-mails só aparecem no console)
# Exemplo Microsoft 365 / Outlook
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu.email@suaempresa.com.br
SMTP_PASS=sua-senha-ou-senha-de-app
MAIL_FROM="Amigo Havaiana <seu.email@suaempresa.com.br>"
